# Auth0 (Single Page Application). Copy this file to .env and fill in your tenant's values.
# These are public identifiers, not secrets: Vite inlines VITE_* vars into the browser bundle.
# Leave them empty to run the game without sign-in (offline demo).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
